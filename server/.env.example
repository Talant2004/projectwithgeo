# Скопируйте в .env и замените все пароли.

# Где хранить базу, настройки GeoServer и снимки (по умолчанию server/data)
DATA_DIR=./data

# PostGIS
POSTGRES_DB=povilika
POSTGRES_USER=povilika
POSTGRES_PASSWORD=change-me-db
# Роль с минимальными правами, под которой GeoServer ходит в базу
GEOSERVER_DB_USER=geoserver_app
GEOSERVER_DB_PASSWORD=change-me-gsdb

# GeoServer (не ниже 2.28.5 / 3.0.1 — исправлена CVE-2026-76904)
GEOSERVER_VERSION=2.28.5
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me-admin
GEOSERVER_MAX_HEAP=2g
# 127.0.0.1 — доступ только с этого ПК; 0.0.0.0 — ещё и из локальной сети
GEOSERVER_BIND=127.0.0.1

# Пользователь мобильного приложения (может только сохранять/удалять очаги)
APP_USER=povilika_app
APP_PASSWORD=change-me-app

# Cloudflare Tunnel
# Пусто — без публичного домена (локальная сеть / временный туннель)
PUBLIC_HOSTNAME=maps.example.com
TUNNEL_TOKEN=

# Для CLI (tools/povilika_cli.py)
GEOSERVER_URL=http://localhost:8080/geoserver
SURVEYS_HOST_DIR=./data/surveys
SURVEYS_CONTAINER_DIR=/data/surveys

# Инспектор — приложение «Полевой маршрут» (только слои inspector_data)
INSPECTOR_USER=inspector_app
INSPECTOR_PASSWORD=change-me-inspector
INSPECTOR_LAYERS_HOST_DIR=./data/inspector_layers
INSPECTOR_LAYERS_CONTAINER_DIR=/data/inspector
FIELDNAV_URL=http://localhost:8000
